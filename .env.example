# Environment Configuration Template
# Duplicate this file as '.env' to specify local environment overrides.
# NOTE: '.env' is automatically ignored by git to protect credentials.

APP_ENV=development
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Optional: Add external database, logging, or API tokens below if integrating with cloud endpoints
# DATABASE_URL=
# MLFLOW_TRACKING_URI=
# API_SECRET_KEY=
